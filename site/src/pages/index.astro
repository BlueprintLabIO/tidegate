---
import Base from '../layouts/Base.astro'

const title = 'Tidegate — stop pasting secrets into coding agents'
const description =
  'Tidegate is a local permissions gate for AI coding agents. Connect GitHub once — Claude, Codex, and Cursor get scoped, audited access. They never see the key.'

const installs = [
  { pm: 'npm', cmd: 'npm install -g tidegate' },
  { pm: 'pnpm', cmd: 'pnpm add -g tidegate' },
  { pm: 'yarn', cmd: 'yarn global add tidegate' },
  { pm: 'brew', cmd: 'brew install blueprintlabio/tap/tidegate' },
  { pm: 'curl', cmd: 'curl -fsSL https://tidegate.dev/install.sh | sh' },
]

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tidegate',
  description,
  url: 'https://tidegate.dev',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
})
---

<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand__glyph">
        <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
          <rect width="32" height="32" fill="#ff5a47"></rect>
          <path d="M6 27V12a10 10 0 0 1 20 0v15" fill="none" stroke="#0f2233" stroke-width="3"></path>
          <path d="M11.5 27V10.5M16 27V7M20.5 27V10.5" fill="none" stroke="#0f2233" stroke-width="3"></path>
          <path d="M3 27h26" stroke="#0f2233" stroke-width="3"></path>
        </svg>
      </span>
      <span class="brand__word sl-display">Tidegate</span>
    </a>
    <span class="topbar__tag sl-label">local permissions gate for coding agents</span>
    <a class="topbar__docs sl-label" href="/docs">Docs</a>
    <a class="sl-btn" href="https://github.com/BlueprintLabIO/tidegate">GitHub&nbsp;↗</a>
  </header>

  <main>
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="hero__head">
        <h1 class="sl-display hero__title sl-rise">
          Stop pasting sec<span class="sl-redact">re</span>ts into agents.
        </h1>
        <span class="sl-stamp hero__stamp">v0 · under construction</span>
      </div>

      <div class="hero__row">
        <div class="hero__left">
          <p class="hero__sub sl-rise" style="animation-delay:.15s">
            Tidegate sits between your agents and your credentials. Connect GitHub once —
            Claude, Codex, and Cursor get scoped, audited access.
            <strong>They never see the key.</strong>
          </p>

          <div class="hero__install sl-rise" style="animation-delay:.25s">
            <span class="sl-label install__label">Get the gate</span>
            <div class="sl-tabs" role="tablist" aria-label="Package manager">
              {installs.map((it, i) => (
                <button class="sl-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pm={it.pm}>
                  {it.pm}
                </button>
              ))}
            </div>
            {installs.map((it, i) => (
              <div class="install__panel" data-pm-panel={it.pm} hidden={i !== 0}>
                <div class="sl-cmd" data-copy={it.cmd} title="Click to copy">
                  <span class="p">$</span>
                  <span>{it.cmd}</span>
                  <span class="sl-cmd__copy">copy</span>
                </div>
              </div>
            ))}
            <p class="install__note sl-mono">
              v0 in development — these commands are the shipping interface.
              <a href="https://github.com/BlueprintLabIO/tidegate">★ the repo</a> to follow.
            </p>
          </div>
        </div>

        <div class="hero__term sl-rise" style="animation-delay:.35s">
          <div class="sl-term">
            <div class="sl-term__bar">
              <span class="sl-term__sq sl-term__sq--a"></span>
              <span class="sl-term__sq sl-term__sq--b"></span>
              <span class="sl-term__sq sl-term__sq--c"></span>
              <span class="sl-term__title">tidegate — zsh</span>
            </div>
            <div class="sl-term__body">
              <div class="tl"><span class="p">$</span> tidegate connect github</div>
              <div class="tl"><span class="ok">✔</span> github → vault  <span class="dim">encrypted · local only</span></div>
              <div class="tl tl--gap"></div>
              <div class="tl"><span class="p">$</span> tidegate install claude codex cursor</div>
              <div class="tl"><span class="ok">✔</span> 3 agents wired  <span class="dim">scoped · no tokens shared</span></div>
              <div class="tl tl--gap"></div>
              <div class="tl"><span class="p">$</span> tidegate dashboard<span class="sl-cursor"></span></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="sl-gauge" role="presentation"></div>

  <main>
    <!-- ================= DAM ================= -->
    <section class="dam" aria-label="How requests flow through the gate: agents upstream, GitHub downstream, keys locked inside the dam">
      <div class="dam__scene" aria-hidden="true">
        <span class="sl-label dam__cap dam__cap--a">your agents<span class="dam__capx"> · upstream</span></span>
        <span class="sl-label dam__cap dam__cap--b">github<span class="dam__capx"> · downstream</span></span>

        <!-- upstream pool (high water) -->
        <div class="dam__water dam__water--l">
          <div class="dam__buoy dam__buoy--b1" style="--d:0s">claude</div>
          <div class="dam__buoy dam__buoy--b2" style="--d:.9s">codex</div>
          <div class="dam__buoy dam__buoy--b3" style="--d:1.7s">cursor</div>
          <div class="dam__token">ghp_••••</div>
        </div>

        <!-- downstream pool (low water) -->
        <div class="dam__water dam__water--r">
          <div class="dam__buoy dam__buoy--r1" style="--d:.5s">repos</div>
          <div class="dam__buoy dam__buoy--r2" style="--d:1.3s">issues</div>
          <div class="dam__buoy dam__buoy--r3" style="--d:2.1s">prs</div>
        </div>

        <!-- the current through the gate -->
        <div class="dam__flow">
          <div class="dam__flowtrack sl-mono">
            <span>read_file → list_issues → create_pr ✔ → read_file → search_code → comment_pr ✔ → </span>
            <span>read_file → list_issues → create_pr ✔ → read_file → search_code → comment_pr ✔ → </span>
          </div>
        </div>

        <!-- the dam wall -->
        <div class="dam__wall">
          <div class="dam__wallbody">
            <span class="dam__name sl-display">Tide<br />gate</span>
            <div class="dam__vault">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M8 11V7a4 4 0 0 1 8 0v4" fill="none" stroke="#0f2233" stroke-width="2.4"></path>
                <rect x="5" y="11" width="14" height="10" fill="#ff5a47" stroke="#0f2233" stroke-width="2.4"></rect>
                <rect x="11" y="14" width="2.4" height="4" fill="#0f2233"></rect>
              </svg>
              <span class="dam__vaultlabel">vault</span>
            </div>
          </div>
          <div class="dam__gatehole">
            <div class="dam__door"></div>
          </div>
        </div>

        <span class="sl-chip sl-chip--gate dam__plate">no tokens beyond this point</span>
      </div>
      <p class="dam__caption sl-mono">
        requests pass through the gate — keys stay behind the wall ·
        <a href="/docs">how it works</a>
      </p>
    </section>

    <!-- ================= FACTS ================= -->
    <section class="facts">
      <article class="fact">
        <span class="fact__num sl-display">01</span>
        <h2 class="fact__title sl-display">Set up once. Every agent gets it.</h2>
        <div class="fact__body">
          <p>
            One connect beats N config files. A new agent onboards with a single
            command — no MCP JSON surgery, no re-pasting keys, one dashboard for
            all of it.
          </p>
        </div>
      </article>

      <article class="fact">
        <span class="fact__num sl-display">02</span>
        <h2 class="fact__title sl-display">They never see the key.</h2>
        <div class="fact__body">
          <p>
            Agents call GitHub through the gate — raw tokens never enter an agent's
            context or a model's transcript. Encrypted vault on your disk, master
            key in your OS keychain.
          </p>
        </div>
      </article>

      <article class="fact fact--last">
        <span class="fact__num sl-display">03</span>
        <h2 class="fact__title sl-display">You hold the veto. And the receipts.</h2>
        <div class="fact__body fact__body--split">
          <div class="fact__text">
            <p>
              Reads flow. Writes wait for your one-click approval. Every action lands
              in an append-only, hash-chained audit log — one revoke button for every agent.
            </p>
            <div class="fact__chips">
              <span class="sl-chip sl-chip--allow">allow · read_file</span>
              <span class="sl-chip sl-chip--ask">ask · create_pr</span>
              <span class="sl-chip sl-chip--deny">deny · push --force</span>
            </div>
          </div>
          <div class="fact__receipt">
            <div class="sl-receipt" role="img" aria-label="Sample audit receipt">
              <div class="sl-receipt__head"><span>audit log</span><span>local</span></div>
              <div class="sl-receipt__row"><span class="t">14:02:11</span><span class="a">claude → github.read_file</span><span class="v v--allow">ALLOW</span></div>
              <div class="sl-receipt__row"><span class="t">14:02:38</span><span class="a">claude → github.create_pr</span><span class="v v--ask">ASK ✔</span></div>
              <div class="sl-receipt__row"><span class="t">14:03:05</span><span class="a">codex → git.push --force</span><span class="v v--deny">DENY</span></div>
              <div class="sl-receipt__hash"><span>chain #a41f…9c2e</span><span>✔ intact</span></div>
            </div>
          </div>
        </div>
      </article>
    </section>
  </main>

  <footer class="footer">
    <span class="sl-mono">Tidegate — MIT or Apache-2.0</span>
    <nav class="footer__links sl-mono">
      <a href="/docs">Docs</a>
      <a href="https://github.com/BlueprintLabIO/tidegate">GitHub</a>
      <a href="https://github.com/BlueprintLabIO/tidegate#threat-model">Threat model</a>
      <a href="https://tidebase.dev">Tidebase</a>
    </nav>
    <span class="sl-mono footer__by">a Blueprint Lab project</span>
  </footer>

  <script>
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) =>
      el.addEventListener('click', function (this: HTMLElement) {
        navigator.clipboard?.writeText(this.dataset.copy!)
        const tag = this.querySelector('.sl-cmd__copy')
        if (tag) {
          const prev = tag.textContent
          tag.textContent = 'copied'
          setTimeout(() => (tag.textContent = prev), 1400)
        }
      })
    )

    const tabs = document.querySelectorAll<HTMLElement>('[data-pm]')
    const panels = document.querySelectorAll<HTMLElement>('[data-pm-panel]')
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)))
        panels.forEach((p) => (p.hidden = p.dataset.pmPanel !== tab.dataset.pm))
      })
    )
  </script>
</Base>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- topbar ---------- */
  .topbar {
    max-width: 1100px;
    margin: 0 auto;
    padding: 26px 24px 0;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand__glyph {
    display: inline-flex;
    border: var(--bw-thin) solid var(--ink);
    box-shadow: var(--shadow-xs);
  }
  .brand__glyph svg { display: block; }
  .brand__word { font-size: 20px; }
  .topbar__tag { color: var(--ink-faint); }
  .topbar__docs {
    margin-left: auto;
    text-decoration: none;
    border-bottom: 2px solid var(--gate);
    padding-bottom: 2px;
  }
  .topbar__docs:hover { color: var(--tide); border-bottom-color: var(--tide); }

  /* ---------- hero ---------- */
  .hero { padding: 76px 0 48px; }
  .hero__head {
    position: relative;
    margin-bottom: 44px;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    max-width: 15ch;
  }
  .hero__stamp {
    position: absolute;
    right: 4%;
    top: -22px;
    transform: rotate(5deg);
  }
  .hero__row {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 60px;
    align-items: start;
  }
  .hero__left { display: flex; flex-direction: column; gap: 34px; min-width: 0; }
  .hero__sub { max-width: 44ch; font-size: 18px; color: var(--ink-soft); }
  .hero__sub strong { color: var(--ink); }
  .hero__term { min-width: 0; align-self: end; }

  .hero__install { display: flex; flex-direction: column; }
  .install__label { margin-bottom: 10px; color: var(--ink-faint); }
  .install__panel .sl-cmd { border-top-width: 0; }
  .install__note { font-size: 11px; color: var(--ink-faint); margin-top: 14px; }
  .install__note a { color: var(--gate); font-weight: 700; }

  /* ---------- dam ---------- */
  .dam { padding: 76px 0 72px; }
  .dam__scene {
    position: relative;
    height: 340px;
    border: var(--bw) solid var(--ink);
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .dam__cap { position: absolute; top: 16px; z-index: 6; color: var(--ink-faint); }
  .dam__cap--a { left: 20px; }
  .dam__cap--b { right: 20px; }

  /* pools — high water upstream, low water downstream */
  .dam__water {
    position: absolute;
    bottom: 0;
    z-index: 1;
    background: var(--tide);
    border-top: var(--bw) solid var(--ink);
  }
  .dam__water--l { left: 0; right: 50%; height: 58%; }
  .dam__water--r { left: 50%; right: 0; height: 36%; }
  .dam__water::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 36%;
    background: rgba(15, 34, 51, 0.22);
  }

  .dam__buoy {
    position: absolute;
    top: 0;
    padding: 4px 9px;
    border: var(--bw-thin) solid var(--ink);
    background: var(--card);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    z-index: 2;
    animation: dam-bob 3.4s ease-in-out infinite alternate;
    animation-delay: var(--d, 0s);
  }
  .dam__buoy--b1 { left: 7%; }
  .dam__buoy--b2 { left: 29%; }
  .dam__buoy--b3 { left: 52%; }
  .dam__buoy--r1 { right: 36%; }
  .dam__buoy--r2 { right: 19%; }
  .dam__buoy--r3 { right: 3%; }
  @keyframes dam-bob {
    from { transform: translateY(-72%); }
    to { transform: translateY(-42%); }
  }

  /* the token that never crosses */
  .dam__token {
    position: absolute;
    top: 0;
    --tx: 86px;
    right: var(--tx);
    padding: 4px 9px;
    border: var(--bw-thin) solid var(--ink);
    background: var(--gate);
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 11px;
    z-index: 2;
    animation: dam-bump 5s ease-in-out infinite;
  }
  @keyframes dam-bump {
    0%, 100% { transform: translate(0, -58%); }
    38% { transform: translate(9px, -52%) rotate(-2deg); }
    52% { transform: translate(9px, -55%) rotate(1deg); }
    72% { transform: translate(0, -58%); }
  }

  /* the current through the gate */
  .dam__flow {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    height: 44px;
    z-index: 2;
    overflow: hidden;
    background: repeating-linear-gradient(90deg, rgba(15, 34, 51, 0.3) 0 26px, transparent 26px 52px);
    animation: dam-current 1.4s linear infinite;
  }
  @keyframes dam-current {
    to { background-position: 52px 0; }
  }
  .dam__flowtrack {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: 10px;
    font-weight: 700;
    color: rgba(241, 239, 229, 0.95);
    animation: dam-marquee 16s linear infinite;
  }
  .dam__flowtrack span { padding-right: 0; }
  @keyframes dam-marquee {
    to { transform: translate(-50%, -50%); }
  }

  /* the wall */
  .dam__wall {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 11%;
    bottom: 0;
    width: 134px;
    z-index: 3;
    display: flex;
    flex-direction: column;
  }
  .dam__wallbody {
    flex: 1;
    border: var(--bw) solid var(--ink);
    border-bottom: 0;
    background:
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(241, 239, 229, 0.22) 26px 29px),
      var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-top: 14px;
  }
  .dam__name {
    color: var(--paper);
    font-size: 16px;
    text-align: center;
    line-height: 1.02;
    letter-spacing: 0.04em;
  }
  .dam__vault {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    background: var(--card);
    border: var(--bw-thin) solid var(--ink);
    padding: 8px 12px 6px;
  }
  .dam__vault svg { display: block; }
  .dam__vaultlabel {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .dam__gatehole {
    height: 96px;
    position: relative;
    border-left: var(--bw) solid var(--ink);
    border-right: var(--bw) solid var(--ink);
  }
  /* the portcullis door, breathing */
  .dam__door {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 56px;
    background: repeating-linear-gradient(90deg, var(--ink) 0 10px, rgba(15, 34, 51, 0.28) 10px 19px);
    border-bottom: 6px solid var(--gate);
    animation: dam-door 7s ease-in-out infinite alternate;
  }
  @keyframes dam-door {
    from { transform: translateY(0); }
    to { transform: translateY(-15px); }
  }

  /* the sign bolted to the wall */
  .dam__plate {
    position: absolute;
    left: 50%;
    top: 63%;
    transform: translate(-50%, -50%) rotate(-3deg);
    z-index: 5;
    box-shadow: var(--shadow-xs);
  }

  .dam__caption {
    margin-top: 22px;
    font-size: 11.5px;
    color: var(--ink-faint);
    text-align: center;
  }
  .dam__caption a { color: var(--gate); font-weight: 700; }

  /* ---------- facts ---------- */
  .facts { padding: 8px 0 96px; }
  .fact {
    display: grid;
    grid-template-columns: 96px 330px 1fr;
    gap: 36px;
    padding: 38px 0;
    border-top: var(--bw) solid var(--ink);
    align-items: start;
  }
  .fact--last { border-bottom: var(--bw) solid var(--ink); }
  .fact__num { font-size: 42px; color: var(--gate); line-height: 1; }
  .fact__title { font-size: 23px; max-width: 14ch; }
  .fact__body p { font-size: 15.5px; color: var(--ink-soft); max-width: 56ch; }
  .fact__body--split {
    display: flex;
    gap: 44px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .fact__text { flex: 1 1 260px; display: flex; flex-direction: column; gap: 16px; }
  .fact__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .fact__receipt { flex: 0 1 330px; transform: rotate(-1.5deg); margin-top: 4px; }

  /* ---------- footer ---------- */
  .footer {
    border-top: var(--bw) solid var(--ink);
    background: var(--card);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    padding: 20px 24px;
    font-size: 12px;
  }
  .footer__links { display: flex; gap: 18px; }
  .footer__links a { font-weight: 700; }
  .footer__links a:hover { color: var(--tide); }
  .footer__by { margin-left: auto; color: var(--ink-faint); }

  /* ---------- responsive ---------- */
  @media (max-width: 940px) {
    .hero { padding-top: 48px; }
    .hero__row { grid-template-columns: 1fr; gap: 40px; }
    .hero__term .sl-term { margin-bottom: -30px; }
    .hero__stamp { position: static; transform: rotate(-3deg); margin-top: 20px; }
    .hero__head { display: flex; flex-direction: column; align-items: flex-start; }
    .topbar__tag { display: none; }
  }
  @media (max-width: 860px) {
    .dam { padding: 52px 0; }
    .dam__scene { height: 300px; }
    .dam__wall { width: 104px; }
    .dam__name { font-size: 13px; }
    .dam__gatehole { height: 80px; }
    .dam__door { height: 46px; }
    .dam__buoy { font-size: 10px; padding: 3px 7px; }
    .dam__token { font-size: 10px; padding: 3px 7px; }
    .dam__cap--a { left: 12px; }
    .dam__cap--b { right: 12px; }
    .dam__flowtrack { display: none; }
    .dam__plate { top: 60%; }
    /* narrow pools: fewer buoys, token pressed against the wall */
    .dam__capx { display: none; }
    .dam__buoy--b2, .dam__buoy--b3, .dam__buoy--r1, .dam__buoy--r2 { display: none; }
    .dam__buoy--b1 { left: 5%; }
    .dam__token { --tx: 34px; }
    .fact { grid-template-columns: 1fr; gap: 14px; padding: 30px 0; }
    .fact__num { font-size: 34px; }
    .fact__receipt { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dam__buoy, .dam__token, .dam__flow, .dam__flowtrack, .dam__door { animation: none; }
  }
</style>
